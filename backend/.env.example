# ===================================
# CONFIGURAÇÃO DO BACKEND
# ===================================

# Aplicação
APP_NAME=Sentrya API
DEBUG=true

# Servidor
HOST=0.0.0.0
PORT=8000

# Simulação de dados
SIMULATION_INTERVAL=1  # segundos

# Limiares de vibração (em g - gravidade)
VIBRATION_ATENCAO=0.8
VIBRATION_ALERTA=1.5
VIBRATION_CRITICO=3.0
